{
  "_comment": "Just Chilling · Configuração da Vercel",

  "_comment_rewrites": "Mantêm URLs amigáveis enquanto servem arquivos internos (ex.: /roadtostatuette → /games/roadtostatuette/index.html).",
  "rewrites": [
    {
      "source": "/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/roadtostatuette",
      "destination": "/games/roadtostatuette/index.html"
    },
    {
      "source": "/wikioculta",
      "destination": "/games/wikioculta/index.html"
    },
    {
      "source": "/crm/login",
      "destination": "/analytics/login.html"
    },
    {
      "source": "/crm/painel",
      "destination": "/analytics/crm.html"
    }
  ],

  "_comment_redirects": "Redirecionamentos mudam a URL do usuário. Aqui /crm sempre leva para a tela de login.",
  "redirects": [
    {
      "source": "/crm",
      "destination": "/crm/login",
      "permanent": false
    }
  ],

  "_comment_headers": "Headers HTTP adicionados automaticamente. Os três primeiros são globais de segurança; os demais impedem cache do CRM.",
  "headers": [
    {
      "_comment": "Segurança global: bloqueia iframe, impede MIME sniffing e protege o referrer.",
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "_comment": "CRM: nunca armazenar em cache.",
      "source": "/analytics/crm.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/analytics/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/analytics/styles/login.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/analytics/scripts/toggle-eye.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}